{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/farmer/(.*)",
      "destination": "/frontend-farmer/$1"
    },
    {
      "source": "/farmer",
      "destination": "/frontend-farmer/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/frontend-admin/$1"
    },
    {
      "source": "/admin",
      "destination": "/frontend-admin/index.html"
    },
    {
      "source": "/",
      "destination": "/api/index.js"
    }
  ]
}
